    "verify:workflow": "bash scripts/verify-devgod-workflow-check.sh",
    "verify:release-overlay": "bash scripts/verify-release-overlay.sh",
    "verify:migrations:live": "node --experimental-strip-types src/admin/devgod.ts verify-live-migrations",
    "verify:review-identity": "node --experimental-strip-types src/admin/devgod.ts verify-review-identity",
    "record:review": "node --experimental-strip-types src/admin/devgod.ts record-review --input .devgod/review-action.json",
    "mcp": "node --experimental-strip-types src/admin/devgod.ts mcp",
    "ui": "node --experimental-strip-types src/admin/devgod.ts serve-ui",
    "setup:playwright": "node --experimental-strip-types src/install/setup-playwright.ts",
