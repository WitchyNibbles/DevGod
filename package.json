  "scripts": {
    "db:start": "docker compose up -d devgod-postgres",
    "db:stop": "docker compose down",
    "install:project": "node --experimental-strip-types src/install/cli.ts",
    "scaffold:workflow": "node --experimental-strip-types src/install/cli.ts scaffold-workflow --target .",
    "seed:happy-path-fixture": "node --experimental-strip-types src/install/cli.ts seed-happy-path-fixture --target .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:coverage": "node --experimental-strip-types scripts/check-coverage.ts",
    "check:quality": "bash scripts/check-quality.sh",
    "check:happy-path": "bash scripts/check-devgod-happy-path.sh",
    "check:workflow": "bash scripts/check-devgod-workflow.sh",
    "eval:orchestration": "node --experimental-strip-types src/evals/orchestration-baseline.ts",
    "benchmark:orchestration": "node --experimental-strip-types src/evals/orchestration-benchmark.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/admin.ts migrate",
    "health": "node --experimental-strip-types src/admin.ts health",
    "bootstrap": "node --experimental-strip-types src/admin.ts bootstrap-project",
    "verify:setup": "node --experimental-strip-types src/admin.ts verify-setup",
    "status": "node --experimental-strip-types src/admin.ts status",
    "ops": "node --experimental-strip-types src/admin.ts ops --format text",
    "recover": "node --experimental-strip-types src/admin.ts recover",
    "verify:workflow": "bash scripts/verify-devgod-workflow-check.sh",
    "verify:release-overlay": "bash scripts/verify-release-overlay.sh",
    "verify:migrations:live": "node --experimental-strip-types src/admin.ts verify-live-migrations",
    "verify:review-identity": "node --experimental-strip-types src/admin.ts verify-review-identity",
    "record:review": "node --experimental-strip-types src/admin.ts record-review --input .devgod/review-action.json",
    "setup:local": "node --experimental-strip-types src/install/setup-local.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "pg": "^8.13.1"
