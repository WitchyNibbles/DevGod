  "scripts": {
    "devgod": "node --experimental-strip-types src/admin/devgod.ts",
    "db:start": "docker compose up -d devgod-postgres",
    "db:stop": "docker compose down",
    "install:project": "node --experimental-strip-types src/install/cli.ts",
    "scaffold:workflow": "node --experimental-strip-types src/install/cli.ts scaffold-workflow --target .",
    "seed:happy-path-fixture": "node --experimental-strip-types src/install/cli.ts seed-happy-path-fixture --target .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepack": "node --experimental-strip-types --eval \"import('./src/install/merge.ts').then((m) => m.writePublishedPackageEntrypoints(process.cwd())).catch((error) => { console.error(error instanceof Error ? error.message : String(error)); process.exitCode = 1; })\"",
    "check:coverage": "node --experimental-strip-types scripts/check-coverage.ts",
    "check:quality": "bash scripts/check-quality.sh",
    "check:happy-path": "bash scripts/check-devgod-happy-path.sh",
    "check:workflow": "bash scripts/check-devgod-workflow.sh",
    "eval:orchestration": "node --experimental-strip-types src/evals/orchestration-baseline.ts",
    "eval:promptfoo:maintainer-boundary": "promptfoo eval -c evals/promptfoo/maintainer-boundary.promptfooconfig.yaml",
    "benchmark:orchestration": "node --experimental-strip-types src/evals/orchestration-benchmark.ts",
    "benchmark:frontier-models": "node --experimental-strip-types src/evals/frontier-model-benchmark.ts",
    "test:properties": "node --experimental-strip-types --test tests/properties/*.test.ts",
    "test:mutation:maintainer-boundary": "stryker run stryker-maintainer-boundary.config.json",
    "test:mutation:maintainer-boundary:dry-run": "stryker run stryker-maintainer-boundary.config.json --dryRunOnly",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/admin/devgod.ts migrate",
    "health": "node --experimental-strip-types src/admin/devgod.ts health",
    "doctor": "node --experimental-strip-types src/admin/devgod.ts doctor",
    "devgod:heal": "node --experimental-strip-types src/admin/devgod.ts doctor --repair",
    "bootstrap": "node --experimental-strip-types src/admin/devgod.ts bootstrap-project",
    "verify:setup": "node --experimental-strip-types src/admin/devgod.ts verify-setup",
    "status": "node --experimental-strip-types src/admin/devgod.ts status",
    "devgod:seed-workflow-proof": "node --experimental-strip-types src/admin/devgod.ts seed-workflow-proof",
    "devgod:advance-active-task": "node --experimental-strip-types src/admin/devgod.ts advance-active-task --format text",
    "devgod:reconcile": "node --experimental-strip-types src/admin/devgod.ts reconcile-runtime-state --apply --format text",
    "devgod:sync-runtime-exports": "node --experimental-strip-types src/admin/devgod.ts sync-runtime-exports --format text",
    "devgod:daemon": "node --experimental-strip-types src/admin/devgod.ts daemon --format text",
    "devgod:supervisor": "node --experimental-strip-types src/admin/devgod.ts supervisor --format text",
    "ops": "node --experimental-strip-types src/admin/devgod.ts ops --format text",
    "devgod:focus": "node --experimental-strip-types src/admin/devgod.ts ops --format text",
    "devgod:loop": "node --experimental-strip-types src/admin/devgod.ts loop --format text",
    "recover": "node --experimental-strip-types src/admin/devgod.ts recover",
    "export:docs": "node --experimental-strip-types src/admin/devgod.ts export-docs",
    "devgod:refresh-retrieval": "node --experimental-strip-types src/admin/devgod.ts refresh-retrieval",
    "devgod:refresh-retrieval:fast": "node --experimental-strip-types src/admin/devgod.ts refresh-retrieval --artifacts-only",
    "devgod:autopilot-status": "node --experimental-strip-types src/devgod/autopilot-status.ts",
    "skills:sync-vendored": "node --experimental-strip-types src/devgod/sync-vendored-skills.ts",
    "verify:agent-caveman": "node --experimental-strip-types src/devgod/verify-agent-caveman-contract.ts",
    "verify:package-surface": "node --experimental-strip-types src/devgod/verify-package-surface.ts",
    "verify:vendored-skills": "node --experimental-strip-types src/devgod/verify-vendored-skills.ts",
