  "scripts": {
    "db:start": "docker compose up -d devgod-postgres",
    "db:stop": "docker compose down",
    "install:project": "node --experimental-strip-types src/install/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:coverage": "node --experimental-strip-types scripts/check-coverage.ts",
    "check:quality": "bash scripts/check-quality.sh",
    "check:workflow": "bash scripts/check-devgod-workflow.sh",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/admin.ts migrate",
    "health": "node --experimental-strip-types src/admin.ts health",
    "bootstrap": "node --experimental-strip-types src/admin.ts bootstrap-project",
    "verify:setup": "node --experimental-strip-types src/admin.ts verify-setup",
    "verify:workflow": "bash scripts/verify-devgod-workflow-check.sh",
    "verify:migrations:live": "node --experimental-strip-types src/admin.ts verify-live-migrations",
    "verify:review-identity": "node --experimental-strip-types src/admin.ts verify-review-identity",
    "setup:local": "node --experimental-strip-types src/install/setup-local.ts"
  },
