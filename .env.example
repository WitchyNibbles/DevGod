DEVGOD_CORE_DATABASE_URL=postgres://devgod:devgod-local-password@127.0.0.1:5432/devgod
DEVGOD_POSTGRES_DB=devgod
DEVGOD_POSTGRES_USER=devgod
DEVGOD_POSTGRES_PASSWORD=devgod-local-password
DEVGOD_POSTGRES_PORT=5432
DEVGOD_DOCKER_CONTAINER_NAME=devgod-postgres
DEVGOD_RUNTIME_PROFILE=local-docker
DEVGOD_QDRANT_URL=http://127.0.0.1:6333
DEVGOD_QDRANT_COLLECTION=devgod-memory
DEVGOD_EMBEDDING_MODEL=devgod-local-hash-1536
DEVGOD_REPO_MARKDOWN_INCLUDE=README.md,AGENTS.md,docs,.devgod,.agents/skills
DEVGOD_QDRANT_PORT=6333
DEVGOD_QDRANT_GRPC_PORT=6334
DEVGOD_QDRANT_CONTAINER_NAME=devgod-qdrant
DEVGOD_WORKSPACE_SLUG=default
DEVGOD_WORKSPACE_NAME="Default Workspace"
DEVGOD_PROJECT_SLUG=devgod
DEVGOD_PROJECT_NAME=devgod
DEVGOD_PROJECT_REPO_PATH=/absolute/path/to/repo
DEVGOD_REVIEW_IDENTITY_BINDINGS=.devgod/review-identity-bindings.json
DEVGOD_REVIEW_IDENTITY_FIXTURES=.devgod/review-identity-adapter.fixture.json
DEVGOD_REVIEW_IDENTITY_ADAPTER_MODULE=./devgod/review-identity-adapter.ts
DEVGOD_OBSIDIAN_ENABLED=false
DEVGOD_OBSIDIAN_VAULT_PATH=/absolute/path/to/obsidian-vault
DEVGOD_OBSIDIAN_DEFAULT_PROJECT=devgod
DEVGOD_OBSIDIAN_DAILY_FOLDER=Devgod/Daily
DEVGOD_OBSIDIAN_DOCS_FOLDER=Devgod/Docs
DEVGOD_OBSIDIAN_ADR_FOLDER=Devgod/ADR
DEVGOD_OBSIDIAN_TIMEZONE=Europe/Madrid
