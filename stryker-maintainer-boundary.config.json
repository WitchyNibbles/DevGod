{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "packageManager": "npm",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "mutate": [
    "src/install/maintainer-boundary.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "tap": {
